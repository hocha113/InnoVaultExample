Items: {
	RitualFlag: {
		DisplayName: 演示仪式旗
		Tooltip:
			'''
			使用后为当前世界记下一次"演示仪式"，聊天栏报告累计次数
			退出并重进世界，次数仍在——这就是 SaveWorld 的世界级存档
			单人：直接生效并在聊天栏看到次数
			多人：由服务器权威写入，并向所有玩家广播同一条消息
			'''
	}

	BeaconRod: {
		DisplayName: 信标杖
		Tooltip:
			'''
			使用后在鼠标位置生成一枚漂浮信标，先金蓝后转红，约九秒后消亡
			寿命与颜色是 [SyncVar] 字段，由权威端推进并自动同步
			联机时客户端的 NewActor 只会返回 -1：请求被路由到服务器生成再广播，所以每个人看到的都是同一枚信标
			'''
	}

	PlatformRod: {
		DisplayName: 平台杖
		Tooltip:
			'''
			使用后在鼠标位置生成一块缓慢往返的漂浮平台，可以站上去被带着走
			单向通行：从下方跳穿上来，按下+跳穿下去，钩爪也能勾住它
			单人：站上去随平台移动
			多人：平台位置服务端权威，碰撞与承载在每个客户端本地解算，所有人看到的运动一致
			'''
	}

	MouseBeacon: {
		DisplayName: 鼠标信标
		Tooltip:
			'''
			握在手里时，把附近玩家的鼠标位置画成光斑标记——自己金色，远程玩家青色
			远程快照按需订阅、只覆盖附近玩家，收起物品后订阅自动过期
			使用一下可在聊天栏查看当前缓存的远程快照数量
			'''
	}
}

Messages: {
	RitualReport: 本世界已举行 {0} 次演示仪式
	MouseBeaconStatus: 当前缓存了 {0} 份远程玩家的鼠标快照
}

DemoCatalog: {
	Entries: {
		UseCounter: {
			Name: 跨世界使用计数（SaveMod）
			HowToTry: 使用本章任意演示物品若干次，退出世界甚至重开游戏后再进，计数仍会继续累加。数据存在 VaultSave/ModDatas 下的独立 NBT 文件里，读档挂在 SetupData、写档挂在退出世界——SaveMod 不会自动保存，时机全靠自己挑。
		}

		WorldFlag: {
			Name: 世界级仪式标记（SaveWorld）
			HowToTry: 使用演示仪式旗，聊天栏会报告本世界的累计仪式次数；退出重进世界数字不丢。换一个新世界则从零开始——数据按世界隔离，多人时只有服务器持有并负责写入。
		}

		ProgressModule: {
			Name: 玩家进度模块（DataModules）
			HowToTry: 用不同的演示物品各触发一次，进度（试过哪些演示、总次数）会写进玩家存档，随角色跨世界。源码里演示了自定义键名、忽略字段、版本号与旧档迁移的完整写法。
		}

		FloatBeacon: {
			Name: 漂浮信标（Actor + SyncVar）
			HowToTry: 手持信标杖对准任意位置使用，鼠标处会出现一枚漂浮光斑，尾声转红后消亡。多人时在客户端使用：NewActor 返回 -1，由服务器分配槽位并广播，所有人看到同一枚信标同步变色、同时消失。
		}

		FloatPlatform: {
			Name: 漂浮平台（SolidActor）
			HowToTry: 手持平台杖对准半空使用，生成一块缓慢往返的平台。跳上去会被平台带着走，按下+跳可以穿下去，钩爪也能勾住它。移动逻辑写在 SolidAI 而不是 AI——这是 SolidActor 的硬规矩。
		}

		MouseBeacon: {
			Name: 鼠标信标（PlayerNetwork）
			HowToTry: 手握鼠标信标，附近玩家的鼠标位置会显示为光斑标记；单人时显示自己的（金色）。多人时对附近玩家按需订阅快照，使用物品可查看当前缓存数量，收起物品后订阅自动过期。
		}
	}
}
