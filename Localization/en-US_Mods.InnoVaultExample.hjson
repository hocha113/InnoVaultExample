# This file will automatically update with entries for new content after a build and reload.

Items: {
	VaultSword: {
		DisplayName: Vault Sword
		Tooltip:
			'''
			Course PRT-101: pooled sparks around the player while held.
			Placeholder art uses vanilla Phaseblade texture.
			'''
	}

	StarFireSword: {
		DisplayName: Star Fire Sword
		Tooltip:
			'''
			Course PRT-102: star particles at the mouse while held.
			Demonstrates lifetime fields and dedServ client guards.
			'''
	}

	ExampleButton: {
		DisplayName: Example Button
		Tooltip: Right-click to open the legacy UIHandle button panel.
	}

	InnoVaultGuidebook: {
		DisplayName: Vault Academy Manual
		Tooltip:
			'''
			Vault Academy entry item.
			Left click: spawn an Academy Beacon Actor and PRT particles at the cursor.
			Right click: open the course catalog panel.
			'''
	}

	AcademyDrillGun: {
		DisplayName: Academy Drill Gun
		Tooltip:
			'''
			Course COMBAT-201 field piece.
			Left click: pierce bolts. Right click or an empty mag starts reload.
			Placeholder art. Swap the PNG when your academy sheet is ready.
			'''
	}

	AcademyTrainingWorkbenchItem: {
		DisplayName: Academy Training Workbench
		Tooltip:
			'''
			Course WORLD-301: mounts a TileProcessor that displays your held item while hovered.
			Sneak-right-click marks training ground cleared (SaveWorld / SavePlayer sample).
			'''
	}

	AcademyTrainingTurretItem: {
		DisplayName: Academy Demon Torch Turret
		Tooltip:
			'''
			Course WORLD-301: auto-targets nearby hostile NPCs after placement.
			Demo targeting utility with server-side projectile spawn.
			'''
	}

	AcademyTrainingLockerItem: {
		DisplayName: Academy Supply Locker
		Tooltip:
			'''
			Course WORLD-301: right-click deposits held items; empty hand withdraws one stack.
			Uses Storages API; locker contents persist across world reload.
			'''
	}

	AcademyGatekeeperSummon: {
		DisplayName: Gatekeeper Sigil
		Tooltip:
			'''
			Course BOSS-201: summons the Academy Gatekeeper FSM/BT boss.
			Watch the intro, recover loop, half-health phase trigger, and alternating behavior-tree attacks.
			'''
	}

	AcademyTutorBeacon: {
		DisplayName: Tutor Beacon
		Tooltip:
			'''
			Course NPC-401: spawns the Academy Vault Tutor near you.
			Talk to the tutor for NPCOverride chat buttons and a NarrativeScenario briefing.
			Single-player / server-side test item.
			'''
	}

	AcademyOverrideLens: {
		DisplayName: Override Lens
		Tooltip:
			'''
			Course OVERRIDE-401: toggles the opt-in Override Gallery.
			Active effects: softer player gravity, workbench tile hook, blue dust tint, and title-menu badge.
			'''
	}
}

Tiles: {
	AcademyTrainingWorkbench.MapEntry: Academy Training Workbench
	AcademyTrainingTurret.MapEntry: Academy Training Turret
	AcademyTrainingLocker.MapEntry: Academy Supply Locker
}

