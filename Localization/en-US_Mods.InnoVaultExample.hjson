	AcademyDrillGunOverride: {
		DisplayName: 学院训练钻枪
		Tooltip:
			'''
			课程 COMBAT-201：左键连射穿甲钉，右键或空弹匣换弹。
			占位美术，后续可替换学院 PNG。
			'''
	}

	ExampleWoodenSwordOverride: {
		DisplayName: 木剑
