	}
}

NPCs: {
	AcademyGatekeeper.DisplayName: Academy Gatekeeper

	AcademyVaultTutor: {
		DisplayName: Academy Vault Tutor

		TownNPCMood: {
			Content: 我很满足。
			NoHome: 我讨厌没有家。
			FarFromHome: 我离家太远了。
			LoveSpace: 我非常喜欢有这么大的空间。
			DislikeCrowded: 我不喜欢这么拥挤。
			HateCrowded: 我讨厌这么拥挤。
			LikeNPC_Princess: 我喜欢 {NPCName}。
			Princess_LovesNPC: 我喜欢 {NPCName}。
		}
	}
}

Dialogue: {
	AcademyVaultTutor: {
		Idle: The catalog is warmer than it looks.
		Progress: You have completed {0} of 3 tracked academy courses. The catalog currently lists {1} showcase entries.
		ButtonBriefing: Briefing
		ButtonCatalog: Catalog
	}
}

Narrative: {
	Tutor: {
		Name: Vault Tutor
		LineWelcome: Welcome back. The Academy uses runnable examples first, theory second.
		LineProgress: Your local record shows {0}/{1} tracked courses complete.
		ChoicePrompt: Which route should we review?
		ChoiceCatalog: Catalog map
		ChoiceCombat: Combat examples
		ChoiceWorld: World systems
		ChoiceDone: That is enough
		PopupCatalogTitle: Catalog Snapshot
		PopupCatalogBody: The guidebook knows {0} showcase entries. {1} of them are Phase 4+ modern-interface entries.
		LineCatalog: The catalog entry is not a replacement for VaultType registration; it is a readable index for players and source readers.
		LineCombat: Combat now has BaseHeldProj, ProjOverride, Trails, ItemUseAnimation, and a boss-side FSM/BT sample.
		LineWorld: The training ground ties TileProcessor, Storages, SaveContent, Actor, RenderHandle, and DataModules into one placeable loop.
		LineClose: Good. Take the next example apart while it still feels runnable.
	}
}

Projectiles: {
	AcademyDrillBolt.DisplayName: Academy Drill Bolt
