# This file will automatically update with entries for new content after a build and reload.

Items: {
	VaultSword: {
		DisplayName: 金库火花剑
		Tooltip:
			'''
			课程 PRT-101：持握时在玩家周围生成池化粒子。
			占位美术来自原版相位剑纹理。
			'''
	}

	StarFireSword: {
		DisplayName: 星火剑
		Tooltip:
			'''
			课程 PRT-102：持握时在鼠标位置生成星火粒子。
			演示 lifetime 字段与 dedServ 客户端守卫。
			'''
	}

	ExampleButton: {
		DisplayName: 示例按钮
		Tooltip: 右键打开旧版 UIHandle 按钮面板。
	}

	InnoVaultGuidebook: {
		DisplayName: 金库学籍手册
		Tooltip:
			'''
			金库学院总入口。
			左键：在光标处生成学院信标 Actor 与 PRT 演示。
			右键：打开课程目录面板。
			'''
	}

	AcademyDrillGun: {
		DisplayName: 学院训练钻枪
		Tooltip:
			'''
			课程 COMBAT-201：左键连射穿甲钉，右键或空弹匣换弹。
			占位美术，后续可替换学院 PNG。
			'''
	}

	AcademyTrainingWorkbenchItem: {
		DisplayName: 学院训练工作台
		Tooltip:
			'''
			课程 WORLD-301：放置后挂载 TileProcessor，悬停展示手持物品。
			潜行右键可标记训练场已清档（SaveWorld / SavePlayer 样本）。
			'''
	}

	AcademyTrainingTurretItem: {
		DisplayName: 学院恶魔火炬炮塔
		Tooltip:
			'''
			课程 WORLD-301：放置后自动瞄准附近敌对 NPC 并发射弹幕。
			演示 targeting 与服务端更新守卫。
			'''
	}

	AcademyTrainingLockerItem: {
		DisplayName: 学院补给储物柜
		Tooltip:
			'''
			课程 WORLD-301：右键存入手持物品，空手可取回一格。
			对接 Storages API，重进世界后柜内物品保留。
			'''
	}

	AcademyGatekeeperSummon: {
		DisplayName: 守门人徽记
		Tooltip:
			'''
			课程 BOSS-201：召唤学院守门人 FSM / BT Boss。
			观察出场、收招、半血 PhaseTrigger 与行为树交替攻击。
			'''
	}

	AcademyTutorBeacon: {
		DisplayName: 导师信标
		Tooltip:
			'''
			课程 NPC-401：在身旁召来宝库导学员。
			与导师对话可测试 NPCOverride 聊天按钮和 NarrativeScenario 简报。
			单人 / 服务端测试物品。
			'''
	}

	AcademyOverrideLens: {
		DisplayName: 覆写透镜
		Tooltip:
			'''
			课程 OVERRIDE-401：切换可选的 Override Gallery。
			启用后可观察玩家重力、工作台物块钩子、蓝火尘埃染色和标题菜单角标。
			'''
	}
}

