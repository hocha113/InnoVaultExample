Dialogue: {
	AcademyVaultTutor: {
		Idle: 目录比它看起来更暖和一点。
		Progress: 你已经完成 {0}/3 门已追踪课程。当前目录登记了 {1} 个示例条目。
		ButtonBriefing: 简报
		ButtonCatalog: 目录
	}
}

Narrative: {
	Tutor: {
		Name: 宝库导学员
		LineWelcome: 欢迎回来。学院先给能跑的例子，再谈抽象理论。
		LineProgress: 你的本地记录显示，已完成 {0}/{1} 门追踪课程。
		ChoicePrompt: 这次想复盘哪条路线？
		ChoiceCatalog: 目录地图
		ChoiceCombat: 战斗示例
		ChoiceWorld: 世界系统
		ChoiceDone: 先到这里
		PopupCatalogTitle: 目录快照
		PopupCatalogBody: 手册目前知道 {0} 个示例条目，其中 {1} 个属于 Phase 4+ 的新接口演示。
		LineCatalog: 目录条目不会替代 VaultType 注册；它只是给玩家和读源码的人看的索引。
		LineCombat: 战斗线现在包含 BaseHeldProj、ProjOverride、Trails、ItemUseAnimation，以及 Boss 侧 FSM / BT 示例。
		LineWorld: 训练场把 TileProcessor、Storages、SaveContent、Actor、RenderHandle 和 DataModules 接进了同一个可放置循环。
		LineClose: 很好。趁示例还保持可运行，把它拆开读一遍。
	}
}

